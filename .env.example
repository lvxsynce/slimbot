# Slim Bot — .env template
# cp .env.example .env && chmod 600 .env && ${EDITOR:-nano} .env
#
# Все ключи ОПЦИОНАЛЬНЫ — если переменная не задана, config.py возьмёт
# встроенный default (см. config.py). Для production ОБЯЗАТЕЛЬНО задай
# Tier 1 (секреты ниже): в репозитории живых значений нет.

# ===== Tier 1: СЕКРЕТЫ (обязательны для production) =====
# Telegram bot token (от @BotFather → /newbot).
TOKEN=
# Telethon user-сессия (https://my.telegram.org → API development tools).
API_ID=
API_HASH=
# Ключ для LLM-провайдера (OpenAI-совместимый endpoint). Без ключа .ии вернёт [x].
AI_API_KEY_WILLOW=
# Можно переопределить модель, effort и endpoint без правки кода.
WILLOW_MODEL=gpt-5.6-luna
WILLOW_REASONING_EFFORT=low
WILLOW_CHAT_URL=https://api.willowapi.digital/v1/chat/completions

# ===== Tier 2: Provider/Service tunables =====
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=60
IPINFO_URL_TEMPLATE=https://ipinfo.io/{ip}/json
DEFAULT_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124 Safari/537.36
DEFAULT_BOT_USERNAME=slimbot

# ===== Tier 3: Telethon / Network =====
TELETHON_RESOLVE_TIMEOUT=10
TELETHON_SEND_TIMEOUT=30
TELETHON_RECONNECT_MAX_DELAY=60
TELETHON_HEALTH_INTERVAL=60
TELETHON_HEALTH_TIMEOUT=15
NETINFO_TIMEOUT_TOTAL=12
NETINFO_TIMEOUT_CONNECT=6
LINKCHECK_TIMEOUT_TOTAL=12
LINKCHECK_TIMEOUT_CONNECT=6
NET_PASSIVE_TIMEOUT=12
NET_PASSIVE_MAX_NAMES=30

# ===== Tier 4: .ии feature tunables =====
AI_TOOL_MAX_ITERATIONS=3
AI_REGEX_SEARCH_SCAN_LIMIT=200
AI_REGEX_SEARCH_MAX_RESULTS=10
AI_DEEP_REPLY_MAX_DEPTH=10
AI_TOOL_OUTPUT_MAX_CHARS=800
AI_CONTEXT_LEN_DEFAULT=20
AI_CONTEXT_LEN_MAX=200
MAX_HISTORY=40
AI_MEMORY_MAX_CHARS=2000
AI_MEMORY_MAX_TOPICS=500
AI_MEMORY_TTL=2592000
AI_REQUEST_LIMIT=10
AI_REQUEST_WINDOW=60
KNOWLEDGE_PROGRESS_INTERVAL=20
KNOWLEDGE_CHECKPOINT_EVERY=100
KNOWLEDGE_HISTORY_WAIT_TIME=1.0
KNOWLEDGE_SEARCH_LIMIT=8
KNOWLEDGE_CONTEXT_MAX_CHARS=12000
KNOWLEDGE_MAX_MESSAGES_PER_OWNER=200000

# ===== Tier 5: Misc / Cleanup =====
AUTH_STATE_TTL=300
AUTH_CLEAN_INTERVAL=60
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW=600
AUTH_COOLDOWN=60
EXPENSIVE_COMMAND_LIMIT=6
EXPENSIVE_COMMAND_WINDOW=60
AUTO_TR_DELAY=0.5
DOT_TARGET_LIMIT=5
INLINE_CACHE_DEFAULT=60
MAX_REDIRECTS=10
NYA_STUTTER_PROB=0.60
NYA_VOWEL_DOUBLE_PROB=0.40
NYA_ACTION_PROB=0.45
NYA_KAOMOJI_PROB=0.55
NYA_MIN_LEN=4
NYA_EDIT_DELAY=0.6
# Каталог данных (по умолчанию — корень проекта).
# SLIMBOT_DATA_DIR=/root/slimbot

# OpenCode stats (.опенкод)
# OPENCODE_API_PASS=
# OPENCODE_API_URL=https://go.gogetfree.ru/
